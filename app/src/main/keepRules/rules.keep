# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Wire-format DTOs are (de)serialized reflectively by Gson. Field names are the protocol,
# so they must not be renamed or removed. Enum constants are matched by name as well.
-keep class dev.nura.app.field.sync.data.dto.** {
    <fields>;
    <init>(...);
}
